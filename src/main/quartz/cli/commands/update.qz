// pluginupdater update: replace outdated plugins and write the changelog.
package net.blueva.pluginupdater.cli.commands.update

import net.blueva.pluginupdater.cli.command.{Command, Values}
import net.blueva.pluginupdater.cli.common
import net.blueva.pluginupdater.core.ui
import net.blueva.pluginupdater.server.config
import net.blueva.pluginupdater.update.run

pub fn declaration() -> Command {
    return Command(
        "update",
        "Replace outdated plugins with their newest builds and write the changelog",
        [common.configOption(), common.onlyOption()],
    )
}

pub fn execute(out: ui.Ui, values: Values) -> Result<int, str> {
    let loaded = config.load(values.text("config") ?? config.File)?
    let done = run.execute(out, loaded, true, values.list("only"))?
    return Ok(run.summary(out, loaded, done, true))
}
